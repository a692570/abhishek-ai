---
import Layout from "../layouts/Layout.astro";
import BookShelf from "../components/BookShelf";
import ReadingHistory from "../components/ReadingHistory.astro";
import reading from "../data/goodreads.json";
import "../styles/global.css";
import "../styles/shelf.css";
const writing = [
  { title: "Loneliness, optimized", date: "Feb 15, 2026", iso: "2026-02-15", slug: "loneliness-optimized", description: "On loneliness, forced optimism, and what the feed does with other people’s pain." },
  { title: "Calculator vs. Employee", date: "Feb 9, 2026", iso: "2026-02-09", slug: "calculator-vs-employee", description: "What changes when we start delegating work to AI instead of copying answers out of it." },
  { title: "Mixtape #4", date: "Mar 17, 2024", iso: "2024-03-17", slug: "mr-beast-the-beast-of-email-marketing", description: "MrBeast’s emails, making friends, and why we put off the things we want to do." },
];
const projects = [
  { name: "LLM Price Chart", slug: "llm-price-chart", description: "A running record of flagship model API prices. A little perspective on how quickly the economics change." },
  { name: "Mitti", slug: "mitti", description: "Mapping family land parcels from official Indian land records, one state at a time." },
];
const moreProjects = [
  { name: "Deckmason", slug: "deckmason", description: "Presentation tools for coding agents, from HTML slides to PDF and PowerPoint." },
  { name: "Customer Zero", slug: "customer-zero", description: "A Codex skill for finding potential first customers from public signals." },
  { name: "Token Maxx", slug: "token-maxx", description: "A local dashboard for tracking AI usage and token spend." },
  { name: "Awesome Product Marketing", slug: "awesome-product-marketing", description: "A collection of resources for product marketers." },
];
---
<Layout title="Abhishek Sharma" description="I work on voice AI at Telnyx, build software I want to use, and write about what I am reading and thinking.">
<a class="skip-link" href="#main">Skip to content</a>
<div class="page">
  <nav class="site-nav" aria-label="Main navigation">
    <a class="wordmark" href="#" aria-label="Abhishek Sharma, back to top">as<span>.</span></a>
    <div class="nav-links">
      <a href="#writing">Writing</a>
      <a href="#projects">Building</a>
      <a href="#bookshelf">Reading</a>
      <button id="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.1A8.6 8.6 0 0 1 10.9 3.5a8.6 8.6 0 1 0 9.6 9.6Z" /></svg>
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
  </nav>
  <header class="intro">
    <div class="intro-copy">
      <h1>Abhishek Sharma<span class="name-dot">.</span></h1>
      <p class="intro-lead">I work on voice AI and the infrastructure behind it at <a href="https://telnyx.com">Telnyx</a>.</p>
      <p class="intro-note">Outside work, I build software I want to use and write about what I’m reading, making, and thinking through.</p>
      <a class="quiet-link" href="#career">Previously at Microsoft, Vapi, and a few startups <span aria-hidden="true">↓</span></a>
    </div>
    <div class="avatar-wrap" id="avatar-wrap" role="img" aria-label="Abhishek Sharma">
      <img src={`${import.meta.env.BASE_URL}profile/abhishek-center.webp`} alt="" class="avatar" width="148" height="148" decoding="async" fetchpriority="high" />
    </div>
  </header>
  <main id="main">
    <section id="writing" aria-labelledby="writing-title">
      <div class="section-heading"><h2 id="writing-title">Some things I’ve written</h2><a class="text-link" href="https://abhismixtape.substack.com">All posts <span aria-hidden="true">↗</span></a></div>
      <div class="writing-list">
        {writing.map((post) => <a class="writing-item" href={`https://abhismixtape.substack.com/p/${post.slug}`}>
          <time datetime={post.iso}>{post.date}</time>
          <div><h3>{post.title}</h3><p>{post.description}</p></div>
          <span class="item-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
      <details class="more-writing"><summary>Earlier notes</summary><div class="earlier-links"><a href="https://abhismixtape.substack.com/p/introducing-solo">Introducing Solo <span aria-hidden="true">↗</span></a><a href="https://abhismixtape.substack.com/p/mixtape-1">Mixtape #1: Reddit IPO, Sound Gen, Mistral <span aria-hidden="true">↗</span></a></div></details>
    </section>
    <section id="projects" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">Things I’m building</h2><a class="text-link" href="https://github.com/a692570">GitHub <span aria-hidden="true">↗</span></a></div>
      <a class="featured-project" href="https://github.com/a692570/bolo">
        <div class="featured-copy"><h3>Bolo</h3><span class="project-meta">Voice dictation · macOS</span><p>Hold a key to dictate into any app.</p><p class="featured-description">Release it to paste your words and get back to work. Powered by Telnyx AI.</p><span class="text-link">Meet Bolo <span aria-hidden="true">↗</span></span></div>
        <img class="bolo-icon" src={`${import.meta.env.BASE_URL}bolo-icon.png`} width="148" height="148" alt="" loading="lazy" />
      </a>
      <div class="project-list">{projects.map((project) => <a class="project-item" href={`https://github.com/a692570/${project.slug}`}><div><h3>{project.name}</h3><p>{project.description}</p></div><span class="item-arrow" aria-hidden="true">↗</span></a>)}</div>
      <details class="more-projects"><summary>A few more projects</summary><div class="project-list">{moreProjects.map((project) => <a class="project-item" href={`https://github.com/a692570/${project.slug}`}><div><h3>{project.name}</h3><p>{project.description}</p></div><span class="item-arrow" aria-hidden="true">↗</span></a>)}</div></details>
    </section>
    <section id="bookshelf" aria-labelledby="bookshelf-title">
      <div class="section-heading"><h2 id="bookshelf-title">Off the screen</h2><a class="text-link" href={reading.profileUrl}>Goodreads <span aria-hidden="true">↗</span></a></div>
      <p class="section-intro">Books I’ve rated five out of five on Goodreads. Pick one up, or explore my full reading history below.</p>
      <div class="bookshelf-frame"><BookShelf client:visible /><noscript><style is:inline>.shelf-experience { display: none; }</style><p>The interactive shelf needs JavaScript. Every title is in the reading history below.</p></noscript></div>
      <ReadingHistory />
    </section>
    <details id="career" class="career-section"><summary><h2>The work so far</h2><span class="career-summary">A short history</span></summary>
      <div class="career-list">
        <div class="career-item"><div class="career-meta"><span class="career-date">2025-Now</span></div><div class="career-details"><span class="career-title">Sr Technical PMM</span><h3><a href="https://telnyx.com" target="_blank" rel="noopener">Telnyx</a></h3><p>Technical marketing for Voice AI: STT, TTS, inference, and real-time communications infrastructure. Competitive intel, product launches, and content for the voice AI category.</p></div></div>
        <div class="career-item"><div class="career-meta"><span class="career-date">2025</span></div><div class="career-details"><span class="career-title">Founding Technical PMM</span><h3><a href="https://vapi.ai" target="_blank" rel="noopener">Vapi</a></h3><p>Product launches and technical content at Vapi, one of the first developer platforms for building voice agents. Joined as the founding PMM.</p></div></div>
        <div class="career-item"><div class="career-meta"><span class="career-date">2024</span></div><div class="career-details"><span class="career-title">Sr Product Marketing Manager</span><h3><a href="https://rafa.ai" target="_blank" rel="noopener">RAFA AI</a></h3><p>Led the Product Hunt launch (1,600+ upvotes, topped AI/finance categories). Grew the app from 0 to $180k ARR in 9 months. 300% increase in customer acquisition, 210% jump in paid subscribers. Spoke with 10 users every week to shape the roadmap.</p></div></div>
        <div class="career-item"><div class="career-meta"><span class="career-date">2023</span></div><div class="career-details"><span class="career-title">PMM Intern</span><h3><a href="https://microsoft.com" target="_blank" rel="noopener">Microsoft</a></h3><p>Redefined positioning for the Microsoft Account across 13 product teams. Customer research, competitive analysis against Google and Apple. Findings influenced product roadmap changes and shipped copy on the MSA landing page.</p></div></div>
        <div class="career-item"><div class="career-meta"><span class="career-date">2021-2022</span></div><div class="career-details"><span class="career-title">Sr Product Marketing Manager</span><h3><a href="https://egen.com" target="_blank" rel="noopener">Egen</a></h3><p>Repositioned Egen for Fortune 500 clients. ABM campaigns generated $455k in revenue. 20% increase in average deal size.</p></div></div>
        <div class="career-item"><div class="career-meta"><span class="career-date">2020-2021</span></div><div class="career-details"><span class="career-title">Agency Owner</span><h3>Self-employed (Dubai)</h3><p>Marketing and growth consultancy. Clients included Volkswagen Dubai, Carasti (31,900 app installs in 60 days, 6.1x ROI), and SandDollar ($138k revenue in 3 months). 10+ startups across 3 continents.</p></div></div>
      </div>

    </details>
  </main>
  <footer class="site-footer">
    <div><h2>Say hello.</h2><p>Especially if you’re building something you wish existed.</p></div>
    <div class="footer-links"><a href="mailto:abhisheksharma@telnyx.com">Email <span aria-hidden="true">↗</span></a><a href="https://www.linkedin.com/in/absheksharma">LinkedIn <span aria-hidden="true">↗</span></a><a href="https://x.com/clawdtalk">X <span aria-hidden="true">↗</span></a><a href="https://abhismixtape.substack.com">Substack <span aria-hidden="true">↗</span></a></div>
    <a class="back-top" href="#">Back to top ↑</a>
  </footer>
</div>
<script>
  import { initFace } from "../components/CursorFace";
  initFace();
  const toggle = document.getElementById("theme-toggle");
  function updateThemeLabel() {
    const label = document.documentElement.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
    toggle?.setAttribute("aria-label", label);
    toggle?.setAttribute("title", label);
  }
  updateThemeLabel();
  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
    updateThemeLabel();
  });
</script>
</Layout>
